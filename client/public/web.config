<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <!-- SPA fallback: any request that isn't a real file/directory falls
         back to index.html so React Router can handle the route.
         Requires the IIS URL Rewrite module (free MS add-on, not installed
         by default). -->
    <rewrite>
      <rules>
        <rule name="React Router SPA" stopProcessing="true">
          <match url=".*" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
          </conditions>
          <action type="Rewrite" url="/index.html" />
        </rule>
      </rules>
    </rewrite>
    <staticContent>
      <remove fileExtension=".json" />
      <mimeMap fileExtension=".json" mimeType="application/json" />
      <mimeMap fileExtension=".webmanifest" mimeType="application/manifest+json" />
    </staticContent>
    <!-- Content-Security-Policy: locked to exactly the external hosts this
         site actually loads (Cloudinary/Unsplash/placehold.co images, Google
         Fonts, Stripe, YouTube embeds, the Render API). style-src needs
         'unsafe-inline' since the app relies heavily on React inline style
         props throughout — removing it would break the site's styling. -->
    <httpProtocol>
      <customHeaders>
        <add name="Content-Security-Policy" value="default-src 'self'; img-src 'self' data: https://res.cloudinary.com https://images.unsplash.com https://placehold.co; media-src 'self' https://res.cloudinary.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; script-src 'self' https://js.stripe.com; frame-src https://js.stripe.com https://www.youtube-nocookie.com; connect-src 'self' https://franell-hair.onrender.com https://api.stripe.com https://m.stripe.network; object-src 'none'; base-uri 'self';" />
      </customHeaders>
    </httpProtocol>
  </system.webServer>
</configuration>
