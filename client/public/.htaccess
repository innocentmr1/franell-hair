RewriteEngine On
RewriteBase /

# Serve real files/directories as-is (JS, CSS, images, robots.txt, sitemap.xml…)
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Everything else falls back to index.html so React Router can handle the route
RewriteRule ^ index.html [L]
