# Server
PORT=5000
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/franell-hair
JWT_SECRET=your_super_secret_jwt_key_here
CLIENT_URL=http://localhost:5173

# Stripe
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key

# Email (Resend — sends over HTTPS, not SMTP, so it works on hosts that block outbound SMTP)
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM=Franell Hair <onboarding@resend.dev>
ADMIN_EMAIL=info@franellhair.com

# Cron (used by the scheduled review-reminder GitHub Action to authenticate)
CRON_SECRET=a_long_random_secret

# Client (prefix with VITE_)
VITE_API_URL=http://localhost:5000/api
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
